# Copie este arquivo para .env (mesma pasta) e preencha. O .env NÃO vai para o Git.
MAIL_USERNAME=seu-usuario@sandboxXXXX.mailgun.org
MAIL_PASSWORD=sua-senha-smtp-do-mailgun
# Caixa que recebe o "Entrar em contato" do site (no sandbox, cadastre em Authorized Recipients)
EMAIL_IMOBILIARIA=seu-email@exemplo.com
# Opcional: chave para assinar os tokens JWT (tem um valor padrão para desenvolvimento)
# JWT_SECRET=troque-por-uma-chave-grande-e-aleatoria
